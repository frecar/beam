{
  "name": "beam-web",
  "private": true,
  "version": "0.3.26",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e scripts",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts e2e scripts",
    "audit": "npm audit --audit-level=high",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@sentry/browser": "^10.70.0"
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Edge versions",
      "last 2 Safari versions",
      "iOS >= 16",
      "Android >= 10",
      "not dead"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
